<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delta_consolidation_group_list" model="ir.ui.view">
        <field name="name">delta.consolidation.group.list</field>
        <field name="model">delta.consolidation.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="member_company_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_delta_consolidation_group_form" model="ir.ui.view">
        <field name="name">delta.consolidation.group.form</field>
        <field name="model">delta.consolidation.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="document_count" widget="statinfo" string="Elimination Documents"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Delta Group"/></h1></div>
                    <group>
                        <field name="currency_id"/>
                        <field name="member_company_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_delta_consolidation_group" model="ir.actions.act_window">
        <field name="name">Consolidation Groups</field>
        <field name="res_model">delta.consolidation.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
